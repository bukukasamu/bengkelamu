rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Super admin: selalu admin, masuk dengan email + kata sandi.
    // Petugas lain: akun PIN, dengan dokumen staff/{email-akun}. Field "peran": admin | registrasi | sparepart | kasir | mekanik
    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.email == 'cashflow.amu@gmail.com'; }
    function staffDoc() { return /databases/$(database)/documents/staff/$(request.auth.token.email); }
    function isStaff() { return isSuper() || (signedIn() && exists(staffDoc())); }
    function hasRole(roles) { return isSuper() || (signedIn() && exists(staffDoc()) && get(staffDoc()).data.peran in roles); }

    // Dibaca sebelum login: daftar nama petugas (nama, peran, akun) dan logo toko
    match /publik/login {
      allow read: if true;
      allow write: if hasRole(['admin']);
    }
    match /publik/brand {
      allow read: if true;
      allow write: if isSuper();
    }

    // Halaman cek servis konsumen: dokumen hanya bisa dibuka bila tahu ID-nya (hash nopol + no. HP),
    // tidak bisa ditelusuri/didaftar. Ditulis otomatis oleh aplikasi petugas.
    match /pantau/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff();
    }

    // Daftar petugas: tiap orang membaca datanya sendiri; admin mengelola semua.
    match /staff/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || hasRole(['admin']));
      allow write: if hasRole(['admin']);
    }

    // Master part: semua petugas membaca; stok berubah lewat penjualan (kasir) dan pembelian (sparepart).
    match /parts/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'sparepart', 'kasir']);
    }

    // Nota penjualan & servis: dibuat kasir, hanya admin yang boleh mengubah/menghapus.
    match /trx/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'kasir']);
      allow update, delete: if hasRole(['admin']);
    }

    // Work order: dibuat registrasi; diperbarui sparepart (order), mekanik (status), kasir (lunas).
    match /wo/{id} {
      allow read: if isStaff();
      allow create: if hasRole(['admin', 'registrasi']);
      allow update: if isStaff();
      allow delete: if hasRole(['admin']);
    }

    match /kendaraan/{id} {
      allow read: if isStaff();
      allow write: if hasRole(['admin', 'registrasi', 'kasir']);
    }

    match /pembelian/{id} { allow read, write: if hasRole(['admin', 'sparepart']); }
    match /imports/{id}   { allow read, write: if hasRole(['admin', 'sparepart']); }
    match /masuk/{id}     { allow read, write: if hasRole(['admin', 'sparepart']); }

    // Master jasa, mekanik, pengaturan: dibaca semua petugas, diubah admin.
    match /jasa/{id}      { allow read: if isStaff(); allow write: if hasRole(['admin']); }
    match /mekanik/{id}   { allow read: if isStaff(); allow write: if hasRole(['admin']); }
    match /meta/settings  { allow read: if isStaff(); allow write: if hasRole(['admin']); }

    // Penomoran otomatis nota / WO / pembelian
    match /meta/counter   { allow read, write: if isStaff(); }
  }
}
